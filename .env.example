# Copy to .env and fill in. Never commit .env.

# Runtime
GOLDSEATS_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# Database. Defaults to a local SQLite file so the API runs without Docker.
# In staging/production set a Postgres URL, e.g.
# DATABASE_URL=postgresql+psycopg://goldseats:password@localhost:5432/goldseats
DATABASE_URL=sqlite+pysqlite:///./goldseats.db

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Film metadata ingestion (M1). Get a key at themoviedb.org/settings/api
TMDB_API_KEY=

# Cache (M9). Leave blank to disable caching locally.
REDIS_URL=

# Auth (M1). Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
